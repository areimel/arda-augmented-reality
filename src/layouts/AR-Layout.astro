---
//Layouts
	import Layout from "./Layout.astro";

//Components
	import HeadAR from "@components/HeadAR.astro";

//Props
	const { title, description, type } = Astro.props;

---

<Layout>
	<HeadAR slot="head" title={title} description={description}/>

	{type === "video" && (
		<script slot="head">
		  // Import AR video handler for video type experiences
		  import { initializeArVideoHandler } from '../utils/arVideoHandler';

		  // Initialize when DOM is ready
		  document.addEventListener('DOMContentLoaded', () => {
		    initializeArVideoHandler();
		  });
		</script>
	)}

	<!-- ===== =========================== ===== -->
	<!-- ===== Slot - Inner Content Insert ===== -->
	<!-- ===== =========================== ===== -->
	<slot />

</Layout>

<style is:global></style>
