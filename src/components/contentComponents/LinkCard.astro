---
const {name, description, link, experienceType, markerImage} = Astro.props;
---

<div class="w-full max-w-[350px] self-stretch border border-gray-300 shadow-md p-4 m-4 bg-white">
	<!-- Marker Image Thumbnail -->
	{markerImage && (
		<div class="mb-3 flex justify-center">
			<img
				src={markerImage}
				alt={`${name} marker`}
				class="w-24 h-24 object-cover rounded border border-gray-200"
			/>
		</div>
	)}

	<!-- Project Name -->
	<h2 class="m-0 pb-2 text-center text-balance border-b border-gray-300 text-xl font-bold">
		{name}
	</h2>

	<!-- Experience Type Badge -->
	{experienceType && (
		<div class="mt-3 flex justify-center">
			<span class="inline-block px-3 py-1 text-sm font-semibold bg-gray-800 text-white rounded-full">
				{experienceType}
			</span>
		</div>
	)}

	<!-- Description -->
	<p class="mt-3 text-center">
		{description}
	</p>

	<!-- Links -->
	<div class="text-center py-4">
		<a
			href={link}
			class="block bg-black text-white py-2 px-4 no-underline mb-4 hover:underline hover:decoration-dotted"
		>
			[Open AR Experience]
		</a>
		<a
			href={`${link}/splash`}
			class="block bg-black text-white py-2 px-4 no-underline mb-4 hover:underline hover:decoration-dotted"
		>
			[Web Splash Page]
		</a>
		<a
			href={`${link}/info`}
			class="block bg-black text-white py-2 px-4 no-underline hover:underline hover:decoration-dotted"
		>
			[Project Info Page]
		</a>
	</div>
</div>
