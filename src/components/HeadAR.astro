---
//Props
	const { title, description } = Astro.props;

//Site Data
	const siteData = await import("src/data/siteData.yaml");
---

<meta charset="UTF-8" />
<title>{title} {siteData.titleSuffix}</title>
<meta name="description" content={description ? description : siteData.fallbackDescription} />
<meta name="viewport" content="width=device-width" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- ===== Fonts ===== -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Kode+Mono&family=Montserrat:wght@200;300;400;500;600;700;800&display=swap" rel="stylesheet">

<!-- ===== Javascript Plugins ===== -->
<!-- All scripts served locally from public/thirdPartyPlugins for improved performance and reliability -->
<!-- A-Frame v1.5.0 - Originally from: https://aframe.io/releases/1.5.0/aframe.min.js -->
<script is:inline src="/thirdPartyPlugins/aframe-1.5.0.min.js"></script>
<!-- MindAR v1.2.5 - Primary AR add-on for A-Frame - Originally from: https://cdn.jsdelivr.net/npm/mind-ar@1.2.5/dist/mindar-image-aframe.prod.js -->
<script is:inline src="/thirdPartyPlugins/mindar-image-aframe-1.2.5.prod.js"></script>
<!-- Chromakey/Green Screen support v1.1.4 - Originally from: https://unpkg.com/aframe-chromakey-material@1.1.4/dist/aframe-chromakey-material.min.js -->
<script is:inline src="/thirdPartyPlugins/aframe-chromakey-material-1.1.4.min.js"></script>
<!-- GIF support - Originally from: https://github.com/mayognaise/aframe-gif-shader -->
<script is:inline src="/thirdPartyPlugins/aframe-gif-shader.min.js"></script>
<!-- GIF component - Originally from: https://github.com/mayognaise/aframe-gif-component -->
<script is:inline src="/thirdPartyPlugins/aframe-gif-component.min.js"></script>

<!-- ===== Internal Javascript - Third Party ===== -->
<script is:inline src="/scripts/xrextras.js"></script>

<!-- ===== Internal Javascript - Custom Functions ===== -->

<script>
  // Import utility functions
  import { initializeQRCodes } from '../utils/qrCode';
  // import { initializeWakeLock } from '../utils/wakeLock';
  import { initializeArFunctions } from '../utils/arFunctions';
  // import { initializeLookAtComponent } from '../utils/aframeLookAt';

  // Initialize when DOM is ready
  document.addEventListener('DOMContentLoaded', () => {
    initializeQRCodes();
    // initializeWakeLock();
    initializeArFunctions();
    // initializeLookAtComponent();
  });
</script>

