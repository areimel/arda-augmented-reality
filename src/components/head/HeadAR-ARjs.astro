---
//Props
	const { title, description } = Astro.props;

//Site Data
	const siteData = await import("src/data/siteData.yaml");
---

<meta charset="UTF-8" />
<title>{title} {siteData.titleSuffix}</title>
<meta name="description" content={description ? description : siteData.fallbackDescription} />
<meta name="viewport" content="width=device-width" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- ===== Fonts ===== -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Kode+Mono&family=Montserrat:wght@200;300;400;500;600;700;800&display=swap" rel="stylesheet">

<!-- ===== AR.js Libraries ===== -->
<!-- A-Frame master build (commit 1c2407b26c61958baa93967b5412487cd94b290b) - Originally from: https://cdn.jsdelivr.net/gh/aframevr/aframe@1c2407b26c61958baa93967b5412487cd94b290b/dist/aframe-master.min.js -->
<script is:inline src="/a-frame-scripts/aframe-master.min.js"></script>
<!-- AR.js v3.4.7 NFT Tracking - Originally from: https://raw.githubusercontent.com/AR-js-org/AR.js/3.4.7/aframe/build/aframe-ar-nft.js -->
<script is:inline src="/thirdPartyPlugins/aframe-ar-nft-3.4.7.js"></script>

<!-- ===== AR.js Loader Styles ===== -->
<style>
	.arjs-loader {
		height: 100%;
		width: 100%;
		position: absolute;
		top: 0;
		left: 0;
		background-color: rgba(0, 0, 0, 0.8);
		z-index: 9999;
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.arjs-loader div {
		text-align: center;
		font-size: 1.25em;
		color: white;
	}
</style>

<!-- ===== Wake Lock Utility ===== -->
<script>
  // Import wake lock utility
  import { initializeWakeLock } from '../utils/wakeLock';

  // Initialize when DOM is ready
  document.addEventListener('DOMContentLoaded', () => {
    initializeWakeLock();
  });
</script>
