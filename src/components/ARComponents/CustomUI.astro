<div class="mindar-ui-overlay flex items-center justify-center absolute inset-0 bg-transparent z-[2] mindar-ui-scanning" id="custom-scanning-overlay">
	<div class="scanning bg-trans-black mix-blend-difference">

		<div class="inner relative w-full h-full opacity-100">

			<!-- <div class="CornerBits absolute w-full h-full pointer-events-none">
				<div class="bit topLeft w-[50px] h-[50px] absolute"></div>
				<div class="bit topRight w-[50px] h-[50px] absolute"></div>
				<div class="bit bottomLeft w-[50px] h-[50px] absolute"></div>
				<div class="bit bottomRight w-[50px] h-[50px] absolute"></div>
			</div> -->

			<div class="scanline absolute w-full h-[10px] bg-custom-white"></div>
			<div class="scanning-text absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full py-4 px-2 text-custom-white">
				<div class="scanning-text-large font-bold text-center text-balance mb-2">{bigText ? bigText : "Scanning..."}</div>
				<div class="scanning-text-small text-[1.25em] text-center text-balance">{smallText ? smallText : "Point your camera at the marker image to view the 3D object."}</div>
				<div class="dynamicText text-[1.25em] text-center mt-4 bg-[#FF0000] py-[0.1em]">
					{flashingText ? flashingText : "[Marker Not In View]"}
				</div>
			</div>

		</div>
	</div>
</div>

<style>
	/* Hidden state for overlay */
	.mindar-ui-overlay.hidden {
		display: none;
	}

	/* Font sizing using CSS variables */
	.mindar-ui-overlay {
		font-size: var(--ar-ui-size-1);
	}

	.scanning-text-large {
		font-size: var(--ar-ui-size-2);
	}

	/* Scanning box responsive sizing */
	.scanning {
		@media (min-aspect-ratio: 1/1) {
			width: 65vh; /* Fallback for older browsers */
			height: 65vh;
			width: 65dvh; /* Dynamic viewport height for modern mobile browsers */
			height: 65dvh;
		}
		@media (max-aspect-ratio: 1/1) {
			width: 80vw; /* Fallback for older browsers */
			height: 80vw;
			width: 80dvw; /* Dynamic viewport width for modern mobile browsers */
			height: 80dvw;
		}
	}

	/* Corner bits CSS variables and positioning */
	.CornerBits {
		--size: 50px;
		--thickness: 8px;
		--offset: 0px;
		--color: var(--white);
	}

	.topLeft {
		top: var(--offset);
		left: var(--offset);
		border-top: solid var(--thickness) var(--color);
		border-left: solid var(--thickness) var(--color);
	}

	.topRight {
		bottom: var(--offset);
		right: var(--offset);
		border-bottom: solid var(--thickness) var(--color);
		border-right: solid var(--thickness) var(--color);
	}

	.bottomLeft {
		bottom: var(--offset);
		left: var(--offset);
		border-bottom: solid var(--thickness) var(--color);
		border-left: solid var(--thickness) var(--color);
	}

	.bottomRight {
		top: var(--offset);
		right: var(--offset);
		border-top: solid var(--thickness) var(--color);
		border-right: solid var(--thickness) var(--color);
	}

	/* Scanline animation */
	.scanline {
		animation: move 2s linear infinite;
	}

	@keyframes move {
		0%, 100% { top: 0% }
		50% { top: calc(100% - 10px) }
	}

	/* Dynamic text flashing animation */
	.dynamicText {
		animation: flash 1.5s linear infinite;
	}

	@keyframes flash {
		0%, 49% { opacity: 1; }
		50%, 99% { opacity: 0; }
		100% { opacity: 1; }
	}

</style>
